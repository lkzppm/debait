# Groq API key, free tier: https://console.groq.com/keys
# Without it the app runs on a clearly labelled mock judge, so the interface can be
# developed without spending quota.
GROQ_API_KEY=

# Limits are per model (8,000 tokens/min and 200,000 tokens/day each on the free tier),
# so the judge and the @deb mention run on different models.
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
# The mention needs the built-in browser_search tool, available only on openai/gpt-oss-*.
GROQ_MENTION_MODEL=openai/gpt-oss-20b

# Set to "mock" to force the mock judge even when GROQ_API_KEY is present.
JUDGE_ENGINE=

# Upstash Redis (Vercel Marketplace integration or https://console.upstash.com).
# Without these the app keeps rooms in memory: fine for `pnpm dev`, wrong for Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password for /admin. In development it falls back to "admin" when unset.
ADMIN_PASSWORD=
